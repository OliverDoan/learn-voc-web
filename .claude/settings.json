{
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(pnpm exec tsc --noEmit *)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm vitest run *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(curl -s http://localhost:3000/*)",
      "Bash(curl -sI http://localhost:3000/*)",
      "Bash(curl -s -o /dev/null -w * http://localhost:3000/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-broad-kill.sh",
            "if": "Bash(pkill *)",
            "timeout": 10,
            "statusMessage": "Kiểm tra lệnh kill…"
          }
        ]
      }
    ]
  }
}
